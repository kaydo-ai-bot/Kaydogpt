# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# AD_NETWORK_PROVIDER: The ad network provider used (e.g., Google AdMob, Unity Ads, AppLovin, AdSense)
AD_NETWORK_PROVIDER="Google AdMob"

# AD_NETWORK_PUBLISHER_ID: The official Publisher / Account ID from the ad network
AD_NETWORK_PUBLISHER_ID=""

# AD_NETWORK_API_KEY: Server-side API key for ad revenue reporting
AD_NETWORK_API_KEY=""

# AD_NETWORK_REPORTING_SECRET: Server-side reporting client secret or token
AD_NETWORK_REPORTING_SECRET=""

# AD_NETWORK_PAYMENT_THRESHOLD: Official minimum payout threshold (default: 100 USD)
AD_NETWORK_PAYMENT_THRESHOLD="100"

# External APIs Configuration (Server-Side Only)
OPENAI_API_KEY="YOUR_KEY_HERE"
OPENAI_MODEL="gpt-4o"

WEB_SEARCH_API_KEY="YOUR_KEY_HERE"
WEB_SEARCH_API_URL="https://www.googleapis.com/customsearch/v1"

NEWS_API_KEY="YOUR_KEY_HERE"
NEWS_API_URL="https://newsapi.org/v2/top-headlines"

WEATHER_API_KEY="YOUR_KEY_HERE"
WEATHER_API_URL="https://api.open-meteo.com/v1/forecast"

YOUTUBE_API_KEY="YOUR_KEY_HERE"
YOUTUBE_API_URL="https://www.googleapis.com/youtube/v3"

TRANSLATION_API_KEY="YOUR_KEY_HERE"
TRANSLATION_API_URL="https://translation.googleapis.com/language/translate/v2"
